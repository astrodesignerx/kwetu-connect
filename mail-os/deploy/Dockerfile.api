FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY apps/api/Kompanion.Api.csproj apps/api/
RUN dotnet restore apps/api/Kompanion.Api.csproj
COPY apps/api/ apps/api/
RUN dotnet publish apps/api/Kompanion.Api.csproj -c Release --no-restore -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN mkdir -p /data/keys /data/attachments && chmod 700 /data/keys /data/attachments && chown -R app:app /data /app
COPY --from=build --chown=app:app /out/ ./
USER app
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "Kompanion.Api.dll"]
