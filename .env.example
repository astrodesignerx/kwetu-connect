# --- Contact form email (Resend) ---
# The contact form (/contact) posts to /api/contact, which sends the inquiry
# via Resend (https://resend.com). Copy this file to .env.local and fill in.

# Server-only Resend API key (Dashboard -> API Keys). Never prefix with
# NEXT_PUBLIC_ — it must stay server-side.
RESEND_API_KEY=

# Inbox that receives submissions. While using the default onboarding@resend.dev
# sender, Resend only delivers to the email that owns your Resend account,
# so this must match that address during testing.
CONTACT_TO_EMAIL=creatives@kwetuconnectads.co.ke

# The "from" address. Use onboarding@resend.dev until you verify your own
# sending domain in Resend, then switch to an address on that domain.
CONTACT_FROM_EMAIL=Kwetu Connect <onboarding@resend.dev>

# Booking storage and staff email-link sign-in. Leave blank for in-memory demo mode.
# Public project URL and anonymous key from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key in browser code or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
